GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
SECRET_KEY=
RUN_SHARE_SECRET=
INTERNAL_API_TOKEN=

ENV=production
FRONTEND_URL=https://your-domain.com
SITE_BASE_URL=https://your-domain.com
CORS_ALLOW_ORIGINS=https://your-domain.com

DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CSRF_TTL_HOURS=8

LOG_OTP=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
MAIL_PORT=587

ASSISTANT_MODEL=gemini-2.5-flash
OWNER_EMAIL=

GENERATION_QUEUE_WAIT_TIMEOUT_SEC=20
GENERATION_QUEUE_MAX_WAITING=4
GENERATION_TOTAL_TIMEOUT_SEC=75
GENERATOR_V25_REPAIR=1
GENERATOR_V25_TIMEOUT_SEC=55
GENERATOR_V25_REPAIR_TIMEOUT_SEC=35
